#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	chosen {
		zephyr,nus-uart = &uart0;
	};

	zephyr,user {
		io-channels = <&adc 7>; /* AIN7 = P0.31 */
	};

	mode_select {
		compatible = "gpio-keys";
		mode_pin: mode_pin {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Mode Selection Pin";
		};
		digi_pin: digi_pin {
			gpios = <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Digipeater Selection Pin";
		};
		standalone_pin: standalone_pin {
			gpios = <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Standalone Selection Pin";
		};
	};

	ptt_control {
		compatible = "gpio-keys";
		ptt_pin: ptt_pin {
			gpios = <&gpio0 22 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "PTT Control Pin";
		};
	};

	gps_control {
		compatible = "gpio-keys";
		gps_enable_pin: gps_enable_pin {
			gpios = <&gpio1 4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "GPS Enable Pin";
		};
	};

};

&uart0 {
	current-speed = <9600>;
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 11)>,
				<NRF_PSEL(UART_RX, 1, 0)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 11)>,
				<NRF_PSEL(UART_RX, 1, 0)>;
			low-power-enable;
		};
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
	};
};

/*
 * TX Audio (Pin 20) is driven by the nRF52840's hardware PWM peripheral
 * instead of bit-banged GPIO: channel 1 is added alongside the board's
 * existing channel 0 (onboard LED, unused by this app) so PWM0 now also
 * routes to P0.20. The peripheral free-runs the carrier in hardware; the
 * app only updates the duty cycle once per audio sample.
 */
&pwm0_default {
	group2 {
		psels = <NRF_PSEL(PWM_OUT1, 0, 20)>;
	};
};

&pwm0_sleep {
	group2 {
		psels = <NRF_PSEL(PWM_OUT1, 0, 20)>;
		low-power-enable;
	};
};

/*
 * This board ships with Adafruit's UF2 bootloader, which - per the board's
 * own Kconfig.defconfig comment - "exists outside of the partitions
 * specified in the DTS file". The vendor DTS's storage_partition (last 32K
 * of flash, 0xf8000-0x100000) is generic MCUboot-template boilerplate that
 * doesn't reflect this board's real layout: the actual Adafruit bootloader
 * for the nRF52840 occupies roughly 0xf4000-0x100000, directly overlapping
 * it. NVS writing there was erasing the bootloader's own settings/MBR-params
 * pages on every boot. Relocate storage well clear of both our own code
 * (currently ~167K starting at 0x1000) and the real bootloader.
 */
&storage_partition {
	reg = <0x90000 0x8000>;
};